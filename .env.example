# ==============================================================================
# Microsoft Sentinel & Microsoft Defender XDR Live Connection Configuration
# ==============================================================================

# 1. Microsoft Entra ID (Azure AD) App Registration Credentials
AZURE_TENANT_ID="00000000-0000-0000-0000-000000000000"
AZURE_CLIENT_ID="00000000-0000-0000-0000-000000000000"
AZURE_CLIENT_SECRET="your_app_registration_client_secret_here"

# 2. Azure Microsoft Sentinel Log Analytics Workspace Details
AZURE_SUBSCRIPTION_ID="00000000-0000-0000-0000-000000000000"
AZURE_RESOURCE_GROUP="rg-sentinel-prod"
AZURE_WORKSPACE_NAME="law-sentinel-cyber-ops"

# 3. Web Server Port (Default: 3333)
PORT=3333
